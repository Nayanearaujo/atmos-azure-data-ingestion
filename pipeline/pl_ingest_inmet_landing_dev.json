{
	"name": "pl_ingest_inmet_landing_dev",
	"properties": {
		"activities": [
			{
				"name": "web_get_apikey",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": true,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://kv-atmos-dev-wus2-2027.vault.azure.net/secrets/visualcrossing-api-key-dev?api-version=7.5",
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "set_year_list",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "web_get_apikey",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "year_list",
					"value": {
						"value": "@range(pipeline().parameters.start_year, add(sub(pipeline().parameters.end_year, pipeline().parameters.start_year), 1))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "foreach_ano",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "set_year_list",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('year_list')",
						"type": "Expression"
					},
					"batchCount": 5,
					"activities": [
						{
							"name": "copy_inmet_to_landing",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "GoogleBigQueryV2Source",
									"query": {
										"value": "@concat(\n    'SELECT * FROM `basedosdados.br_inmet_bdmep.microdados` WHERE id_estacao = ''',\n    pipeline().parameters.id_estacao,\n    ''' AND ano = ',\n    string(item())\n)",
										"type": "Expression"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_bigquery_inmet_src_dev",
									"type": "DatasetReference",
									"parameters": {
										"id_estacao": "@pipeline().parameters.id_estacao",
										"ano": "@item()"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_csv_inmet_landing_dev",
									"type": "DatasetReference",
									"parameters": {
										"ano": {
											"value": "@string(item())",
											"type": "Expression"
										},
										"file_name": "@toLower(     concat(         'atmos_',         pipeline().parameters.id_estacao,         '_',         string(item()),         '_',         formatDateTime(utcNow(), 'yyyyMMddHHmmss'),         '.csv'     ) )"
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"id_estacao": {
				"type": "string"
			},
			"start_year": {
				"type": "int"
			},
			"end_year": {
				"type": "int"
			}
		},
		"variables": {
			"year_list": {
				"type": "Array"
			}
		},
		"annotations": []
	}
}